# Copy this file to `.env` in the same folder (frontend/.env).
# Never commit `.env` — it is gitignored.

# Backend API base URL (no trailing slash)
VITE_API_LINK=http://localhost:8080

# Must match backend API_DEV_KEY — sent as x-api-key on data requests
VITE_API_DEV_KEY=your-local-api-key-here

DOMAIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google Sign-In — OAuth 2.0 Web client ID from Google Cloud Console.
# Authorized JavaScript origins must include http://localhost:5173 and the
# production site (https://getopenmap.com).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
