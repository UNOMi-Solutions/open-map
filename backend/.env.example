# Copy this file to `.env` in the same folder (backend/.env).
# Never commit `.env` — it is gitignored.

# Server
PORT=8080
NODE_ENV=development

# Required for protected data routes (frontend sends this as x-api-key)
API_DEV_KEY=your-local-api-key-here

# Database (auth: register, login, verify)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/openmap

# ── External data API keys (replace placeholders with real keys) ──────────────

# Crime + law enforcement (FBI) — https://api.data.gov/signup/
FBI_CRIME_KEY=your-fbi-crime-api-key

# Census population — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-api-key

# State GDP — https://apps.bea.gov/API/signup/
BEA_API_KEY=your-bea-api-key

# Environment
EIA_API_KEY=your-eia-api-key
AQICN_API_TOKEN=your-aqicn-token

# Health (optional — CDC public API works without this; improves rate limits)
# https://data.cdc.gov/profile/edit/developer_settings
HEALTHDATA_API_KEY=your-healthdata-api-key

# Auth email (register verification) — https://resend.com/
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@getopenmap.com
FRONTEND_URL=http://localhost:5173

# Optional — JWT login (middleware already supports it)
JWT_SECRET=your-jwt-secret

# Optional — future AI features
OPENAI_API_KEY=your-openai-api-key
